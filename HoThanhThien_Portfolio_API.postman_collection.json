            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Debugging High-Volume Backend Systems with Postman (Revised)\",\n  \"published\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/blog/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blog", "1"]
            },
            "description": "Updates a blog article. Requires Bearer Token."
          }
        },
