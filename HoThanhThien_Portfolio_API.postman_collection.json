{
  "info": {
    "_postman_id": "7b8f9a2e-4c1d-4890-a8d1-123456789abc",
    "name": "Ho Thanh Thien - Portfolio & CMS REST API",
    "description": "Production RESTful API Collection for Ho Thanh Thien's Portfolio & CMS Platform (Laravel 9 + PostgreSQL/MySQL).\n\nIncludes endpoints for Projects, Blog Posts (Full CRUD), Skills, Experiences, Contact Form submissions, and Sanctum Token Authentication.\n\nLive Deployed URL: https://hothanhthien.io.vn\nSwagger Docs: https://hothanhthien.io.vn/api/docs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://hothanhthien.io.vn",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Generate Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Sanctum Token saved:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hothanhthien119@gmail.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates admin user and returns a Laravel Sanctum Bearer token. The test script automatically saves this token into the {{token}} collection variable."
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Returns authenticated user information."
          }
        },
        {
          "name": "Logout (Revoke Token)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes current Sanctum API token."
          }
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects"]
            },
            "description": "Retrieves all portfolio projects with attached technology badges."
          }
        },
        {
          "name": "Filter Featured Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?featured=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects"],
              "query": [{ "key": "featured", "value": "true" }]
            },
            "description": "Filters projects marked as featured."
          }
        },
        {
          "name": "Get Project by ID (e.g. Project 4)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects", "4"]
            },
            "description": "Fetches single project details by ID."
          }
        },
        {
          "name": "Create Project (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Microservices Architecture\",\n  \"description\": \"Designed high-scale distributed backend services with Docker, Redis caching, and CI/CD pipelines.\",\n  \"github_url\": \"https://github.com/hoThanhThien\",\n  \"demo_url\": \"https://hothanhthien.io.vn\",\n  \"featured\": true,\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects"]
            },
            "description": "Creates a new project. Requires Bearer Token."
          }
        },
        {
          "name": "Update Project (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Personal Portfolio & CMS (Updated via API)\",\n  \"featured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects", "4"]
            },
            "description": "Updates project fields. Requires Bearer Token."
          }
        },
        {
          "name": "Delete Project (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects", "999"]
            },
            "description": "Deletes a project. Requires Bearer Token."
          }
        }
      ]
    },
    {
      "name": "3. Blog Posts (CRUD)",
      "item": [
