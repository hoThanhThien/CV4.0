              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blog"],
              "query": [{ "key": "per_page", "value": "10" }]
            },
            "description": "Lists published blog articles with pagination metadata."
          }
        },
        {
          "name": "Get Single Post by Slug",
          "request": {
