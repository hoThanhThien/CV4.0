            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/blog/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blog", "999"]
            },
            "description": "Deletes a blog post by ID. Requires Bearer Token."
          }
        }
      ]
    },
