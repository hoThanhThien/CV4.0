        {
          "name": "Create Blog Post (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Debugging High-Volume Backend Systems with Postman\",\n  \"excerpt\": \"Best practices for isolating backend bugs, analyzing server logs, and verifying API regression.\",\n  \"content\": \"# Debugging Backend Systems\\n\\nI usually debug backend issues by first reproducing the problem locally and checking application logs for errors, stack traces, and relevant request details.\\n\\nI then inspect the affected API endpoints, business logic, database queries, and environment configuration to identify the root cause.\\n\\nAfter implementing a fix, I test normal and edge cases using Postman and verify that the issue is resolved without introducing regressions. For production issues, I also check server logs and deployment configuration.\",\n  \"published\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/blog",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "blog"]
            },
            "description": "Creates a new blog article. Requires Bearer Token."
          }
        },
        {
          "name": "Update Blog Post (Admin)",
          "request": {
            "auth": {
